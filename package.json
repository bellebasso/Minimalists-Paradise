{
  "name": "minimalists-paradise",
  "version": "0.1.65",
  "description": "[![License](https://img.shields.io/badge/license-MIT-474E5C?style=plastic&logo=github&logoColor=white&labelColor=B7BCC9&color=474E5C)](LICENSE) [![Made for Obsidian](https://img.shields.io/badge/made%20for-Obsidian-5E6573?style=plastic&logo=obsidian&logoColor=white&labelColor=979DAA&color=5E6573)](https://obsidian.md) [![Version](https://img.shields.io/badge/dynamic/json?url=https://raw.githubusercontent.com/bellebasso/Minimalists-Paradise/main/manifest.json&query=$.version&label=version&style=plastic&logo=git&logoColor=white&colorA=787F8D&colorB=787F8D)](https://github.com/bellebasso/Minimalists-Paradise/releases) [![Last Commit](https://img.shields.io/github/last-commit/bellebasso/Minimalists-Paradise?style=plastic&logo=git&logoColor=white&colorA=4F5867&colorB=979DAA)](https://github.com/bellebasso/Minimalists-Paradise/commits/main) [![GitHub issues](https://img.shields.io/github/issues/bellebasso/Minimalists-Paradise?style=plastic&logo=github&logoColor=white&colorA=3D4450&colorB=B7BCC9)](https://github.com/bellebasso/Minimalists-Paradise/issues) [![Closed Issues](https://img.shields.io/github/issues-closed/bellebasso/Minimalists-Paradise?style=plastic&logo=github&logoColor=white&colorA=353B45&colorB=C5C9D3)](https://github.com/bellebasso/Minimalists-Paradise/issues?q=is%3Aissue+is%3Aclosed)",
  "main": "index.js",
  "scripts": {
    "bundle": "node scripts/bundle.js",
    "dev": "chokidar \"src/**/*.css\" \"manifest.json\" -c \"npm run build && npm run sync\" --initial",
    "sync": "dotenv -- ./scripts/sync-to-obsidian.sh",
    "build": "npm run bundle && npm run css:merge && npm run lint && npm run css:check",
    "lint": "stylelint theme.css",
    "lint:fix": "stylelint theme.css --fix",
    "css:check": "node scripts/css-checklist.js",
    "css:merge": "node scripts/merge-duplicates.js",
    "preversion": "npm run build",
    "version": "node scripts/update-manifest.js && git add manifest.json",
    "postversion": "echo Release created! Don't forget to push the changes and create a new release on GitHub. Run 'git push origin main --follow-tags' to push the changes and tags to GitHub.",
    "release": "npm version patch -m \"chore(release): %s\"",
    "release:patch": "npm version patch -m \"chore(release): %s\"",
    "release:minor": "npm version minor -m \"chore(release): %s\"",
    "release:major": "npm version major -m \"chore(release): %s\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bellebasso/Minimalists-Paradise.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/bellebasso/Minimalists-Paradise/issues"
  },
  "homepage": "https://github.com/bellebasso/Minimalists-Paradise#readme",
  "dependencies": {
    "axios": "^1.17.0",
    "cheerio": "^1.2.0"
  },
  "devDependencies": {
    "chokidar-cli": "^3.0.0",
    "dotenv-cli": "^11.0.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.14",
    "postcss-combine-duplicated-selectors": "^10.0.3",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
